<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.Debugger.ViewModels"
	xmlns:c="using:Mesen.Debugger.Controls"
	xmlns:du="using:Mesen.Debugger.Utilities"
	mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="vm:CallerCalleeViewModel"
	x:Class="Mesen.Debugger.Views.CallerCalleeView"
>
	<Design.DataContext>
		<vm:CallerCalleeViewModel />
	</Design.DataContext>

	<Border BorderThickness="0 1 0 0" BorderBrush="{StaticResource MesenGrayBorderColor}">
		<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,2*">
			<!-- 复制工具栏 -->
			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2" Spacing="4" >
				<Button Content="{l:Translate btnCopyAllRecords}" Command="{Binding ActiveCopyAllCommand}"/>
				<Button Content="{l:Translate btnCopyCallGraph}" Command="{Binding ActiveCopyGraphCommand}"/>
				<TextBlock Text="{l:Translate lblCopyDepth}" VerticalAlignment="Center"/>
				<NumericUpDown Value="{Binding CopyDepth}" Minimum="1" Maximum="16" Width="20"/>
				<CheckBox Content="{l:Translate chkCopyWithAccess}" IsChecked="{Binding CopyWithAccess}"/>
				<CheckBox Content="{l:Translate chkCopyWithAssembly}" IsChecked="{Binding CopyWithAssembly}"/>
			</StackPanel>

			<!-- Callers Header -->
			<Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding ShowFuncPanel}">
				<TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{l:Translate lblFuncAccess}" VerticalAlignment="Center" Margin="4,0,0,0" />
				<CheckBox Grid.Row="0" Grid.Column="1" Content="{l:Translate colMarked}" IsChecked="{Binding SelectedFunctionMarked}" VerticalAlignment="Center" />
				<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedFunctionName}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" Cursor="Hand" PointerPressed="OnSelectedFuncPointerPressed" />
				<TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Text="{l:Translate lblCallers}" IsVisible="{Binding ShowCallers}" />
				<CheckBox Grid.Row="1"  Grid.Column="2" Content="{l:Translate chkShowCached}" IsChecked="{Binding ShowCached}" />
			</Grid>

			<!-- Callers DataBox -->
			<DataBox
				x:Name="callersGrid"
				Grid.Row="3"
				Items="{Binding Callers}"
				Selection="{Binding CallerSelection}"
				IsVisible="{Binding ShowCallers}"
				GridLinesVisibility="All"
				CellClick="OnCellClick"
				CellDoubleClick="OnCallerCellDoubleClick"
				ColumnWidths="{Binding ColumnWidths}" 
				>
				<DataBox.Styles>
					<Style Selector="DataBoxRow /template/ Rectangle#BackgroundRectangle">
						<Setter Property="Fill" Value="{Binding RowBackground, DataType={x:Type vm:CallerCalleeEntry}}" />
					</Style>
					<Style Selector="DataBoxRow">
						<Setter Property="Foreground" Value="{Binding RowForeground, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="FontStyle" Value="{Binding RowStyle, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="FontWeight" Value="{Binding RowWeight, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="Opacity" Value="{Binding RowOpacity, DataType={x:Type vm:CallerCalleeEntry}}" />
					</Style>
				</DataBox.Styles>
				<DataBox.Columns>
					<DataBoxCheckBoxColumn
						ColumnName="Marked"
						Header="{l:Translate colMarked}"
						Binding="{Binding IsMarked, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="30"
					/>
					<DataBoxTextColumn
						ColumnName="Function"
						Header="{l:Translate colFunction}"
						Binding="{Binding FunctionName, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="45"
					/>
					<DataBoxTextColumn
						ColumnName="RelAddr"
						Header="{l:Translate colCpuAddr}"
						Binding="{Binding RelAddressDisplay, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="70"
					/>
					<DataBoxTextColumn
						ColumnName="AbsAddr"
						Header="{l:Translate colRomAddr}"
						Binding="{Binding AbsAddressDisplay, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="70"
					/>
					<DataBoxTextColumn
						ColumnName="CallCount"
						Header="{l:Translate colCallCount}"
						Binding="{Binding CallCount, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="40"
					/>
				</DataBox.Columns>
			</DataBox>

			<!-- Callees Header -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,8,4,2" IsVisible="{Binding ShowCallees}">
				<TextBlock Text="{Binding SelectedFunctionName}" Opacity="0.7" Cursor="Hand" PointerPressed="OnSelectedFuncPointerPressed" />
				<TextBlock Text=" " />
				<TextBlock FontWeight="Bold" Text="{l:Translate lblCallees}" />
			</StackPanel>

			<!-- Callees DataBox -->
			<DataBox
				x:Name="calleesGrid"
				Grid.Row="5"
				Items="{Binding Callees}"
				Selection="{Binding CalleeSelection}"
				IsVisible="{Binding ShowCallees}"
				GridLinesVisibility="All"
				CellClick="OnCellClick"
				CellDoubleClick="OnCalleeCellDoubleClick"
				ColumnWidths="{Binding ColumnWidths}" 
				>
				<DataBox.Styles>
					<Style Selector="DataBoxRow /template/ Rectangle#BackgroundRectangle">
						<Setter Property="Fill" Value="{Binding RowBackground, DataType={x:Type vm:CallerCalleeEntry}}" />
					</Style>
					<Style Selector="DataBoxRow">
						<Setter Property="Foreground" Value="{Binding RowForeground, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="FontStyle" Value="{Binding RowStyle, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="FontWeight" Value="{Binding RowWeight, DataType={x:Type vm:CallerCalleeEntry}}" />
						<Setter Property="Opacity" Value="{Binding RowOpacity, DataType={x:Type vm:CallerCalleeEntry}}" />
					</Style>
				</DataBox.Styles>
				<DataBox.Columns>
					<DataBoxCheckBoxColumn
						ColumnName="Marked"
						Header="{l:Translate colMarked}"
						Binding="{Binding IsMarked, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="30"
					/>
					<DataBoxTextColumn
						ColumnName="Function"
						Header="{l:Translate colFunction}"
						Binding="{Binding FunctionName, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="45"
					/>
					<DataBoxTextColumn
						ColumnName="RelAddr"
						Header="{l:Translate colCpuAddr}"
						Binding="{Binding RelAddressDisplay, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="70"
					/>
					<DataBoxTextColumn
						ColumnName="AbsAddr"
						Header="{l:Translate colRomAddr}"
						Binding="{Binding AbsAddressDisplay, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="70"
					/>
					<DataBoxTextColumn
						ColumnName="CallCount"
						Header="{l:Translate colCallCount}"
						Binding="{Binding CallCount, DataType={x:Type vm:CallerCalleeEntry}}"
						InitialWidth="40"
					/>
				</DataBox.Columns>
			</DataBox>

			<!-- 访问记录面板（函数记录模式） -->
			<Grid Grid.Row="6" Margin="4,4,4,4" RowDefinitions="Auto,Auto,*" IsVisible="{Binding SelectedFunctionMarked}">
				<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
					<TextBlock Grid.Column="0" FontWeight="Bold" Text="{l:Translate lblMemoryAccess}" VerticalAlignment="Center" Margin="4,0,0,0" />
					<CheckBox Grid.Column="2" Content="{l:Translate chkShowAllFunctions}" IsChecked="{Binding ShowAllFunctions}" />
					<Button Grid.Column="3" Content="{l:Translate btnRetrack}" Command="{Binding RetrackCommand}" />
				</Grid>
				<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4" Spacing="8">
					<CheckBox Content="{l:Translate chkTrackExec}" IsChecked="{Binding TrackInstructionFetch}" />
					<CheckBox Content="{l:Translate chkTrackDummy}" IsChecked="{Binding TrackDummy}" />
					<CheckBox Content="{l:Translate chkTrackPpu}" IsChecked="{Binding TrackPpuRender}" />
					<CheckBox Content="{l:Translate lblShowBlocked}" IsChecked="{Binding ShowBlockedRanges}" />
				</StackPanel>
				<Grid Grid.Row="2" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" Text="{l:Translate lblNoAccessData}" IsVisible="{Binding !HasAccessData}" />
					<DataBox
						x:Name="accessGrid"
						Grid.Row="1"
						Items="{Binding MarkedAccessRanges}"
						Selection="{Binding AccessRangeSelection}"
						IsVisible="{Binding HasAccessData}"
						GridLinesVisibility="All"
						SelectionMode="Multiple"
						ColumnWidths="{Binding AccessRangesColumnWidths}"
						PointerPressed="OnAccessPointerPressed"
						CellDoubleClick="OnAccessRangeCellDoubleClick"
						SortMode="Multiple"
						SortState="{Binding AccessRangeSortState}"
						SortCommand="{Binding AccessRangeSortCommand}"
						>
						<DataBox.Styles>
							<Style Selector="DataBoxRow /template/ Rectangle#BackgroundRectangle">
								<Setter Property="Fill" Value="{Binding RowBackground, DataType={x:Type vm:AccessRangeViewModel}}" />
							</Style>
							<Style Selector="DataBoxRow">
								<Setter Property="Foreground" Value="{Binding RowForeground, DataType={x:Type vm:AccessRangeViewModel}}" />
								<Setter Property="FontStyle" Value="{Binding RowStyle, DataType={x:Type vm:AccessRangeViewModel}}" />
								<Setter Property="FontWeight" Value="{Binding RowWeight, DataType={x:Type vm:AccessRangeViewModel}}" />
								<Setter Property="Opacity" Value="{Binding RowOpacity, DataType={x:Type vm:AccessRangeViewModel}}" />
							</Style>
						</DataBox.Styles>
						<DataBox.Columns>
							<DataBoxTextColumn
								ColumnName="Range"
								Header="{l:Translate colRange}"
								Binding="{Binding RangeDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="160"
							/>
							<DataBoxTextColumn
								ColumnName="Rw"
								Header="{l:Translate colRw}"
								Binding="{Binding RwDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="25"
							/>
							<DataBoxTextColumn
								ColumnName="MemType"
								Header="{l:Translate colMemType}"
								Binding="{Binding MemTypeDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="50"
							/>
							<DataBoxTextColumn
								ColumnName="ReadCount"
								Header="{l:Translate colReadCount}"
								Binding="{Binding ReadCountDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="30"
							/>
							<DataBoxTextColumn
								ColumnName="WriteCount"
								Header="{l:Translate colWriteCount}"
								Binding="{Binding WriteCountDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="30"
							/>
							<DataBoxTextColumn
								ColumnName="AccessCount"
								Header="{l:Translate colAccessCount}"
								Binding="{Binding AccessCountDisplay, DataType={x:Type vm:AccessRangeViewModel}}"
								InitialWidth="30"
							/>
						</DataBox.Columns>
					</DataBox>
				</Grid>
			</Grid>

			<!-- 断点记录（反向）面板：仅断点记录模式显示 -->
			<Grid Grid.Row="6" Margin="4,4,4,4" RowDefinitions="Auto,*" IsVisible="{Binding IsBreakpointMode}">
				<Grid Grid.Row="0" ColumnDefinitions="Auto,*">
					<TextBlock Grid.Column="0" FontWeight="Bold" Text="{l:Translate lblBreakpointAccess}" VerticalAlignment="Center" Margin="4,0,0,0" />
					<TextBlock Grid.Column="1" Text="{Binding SelectedBreakpointTitle}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8" />
				</Grid>
				<Grid Grid.Row="1" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" Text="{l:Translate lblNoBreakpointAccessData}" IsVisible="{Binding !HasReverseData}" />
					<DataBox
						x:Name="reverseGrid"
						Grid.Row="1"
						Items="{Binding AccessedByFunctions}"
						Selection="{Binding AccessedBySelection}"
						IsVisible="{Binding HasReverseData}"
						GridLinesVisibility="All"
						CellDoubleClick="OnReverseCellDoubleClick"
						ColumnWidths="{Binding ReverseColumnWidths}"
					>
						<DataBox.Styles>
							<Style Selector="DataBoxRow /template/ Rectangle#BackgroundRectangle">
								<Setter Property="Fill" Value="{Binding RowBackground, DataType={x:Type vm:MemoryAccessFunctionEntry}}" />
							</Style>
							<Style Selector="DataBoxRow">
								<Setter Property="Foreground" Value="{Binding RowForeground, DataType={x:Type vm:MemoryAccessFunctionEntry}}" />
								<Setter Property="FontStyle" Value="{Binding RowStyle, DataType={x:Type vm:MemoryAccessFunctionEntry}}" />
								<Setter Property="FontWeight" Value="{Binding RowWeight, DataType={x:Type vm:MemoryAccessFunctionEntry}}" />
								<Setter Property="Opacity" Value="{Binding RowOpacity, DataType={x:Type vm:MemoryAccessFunctionEntry}}" />
							</Style>
						</DataBox.Styles>
						<DataBox.Columns>
							<DataBoxCheckBoxColumn
								ColumnName="Marked"
								Header="{l:Translate colMarked}"
								Binding="{Binding IsMarked, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="30"
							/>
							<DataBoxTextColumn
								ColumnName="Function"
								Header="{l:Translate colFunction}"
								Binding="{Binding FunctionName, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="45"
							/>
							<DataBoxTextColumn
								ColumnName="RelAddr"
								Header="{l:Translate colCpuAddr}"
								Binding="{Binding RelAddressDisplay, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="70"
							/>
							<DataBoxTextColumn
								ColumnName="AbsAddr"
								Header="{l:Translate colRomAddr}"
								Binding="{Binding AbsAddressDisplay, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="70"
							/>
							<DataBoxTextColumn
								ColumnName="AccessCount"
								Header="{l:Translate colAccessCount}"
								Binding="{Binding AccessCount, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="40"
							/>
							<DataBoxTextColumn
								ColumnName="Rwe"
								Header="{l:Translate colRwe}"
								Binding="{Binding RweDisplay, DataType={x:Type vm:MemoryAccessFunctionEntry}}"
								InitialWidth="40"
							/>
						</DataBox.Columns>
					</DataBox>
				</Grid>
			</Grid>
		</Grid>
	</Border>
</UserControl>
